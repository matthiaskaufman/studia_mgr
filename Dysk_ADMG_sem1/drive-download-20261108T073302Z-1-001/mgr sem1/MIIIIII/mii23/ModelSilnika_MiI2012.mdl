<chart id="30">
  <P Name="name">MATLAB Function2</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">30</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">10</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">3</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">cechy_domega</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">30</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function x = cechy_domega(Uw, Ut, M, Iw, It, omega_prev)

D = 10;

persistent bUw bUt bM bIw bIt bOm

if isempty(bUw)
    bUw = zeros(D+1,1);
    bUt = zeros(D+1,1);
    bM  = zeros(D+1,1);
    bIw = zeros(D+1,1);
    bIt = zeros(D+1,1);
    bOm = zeros(D,1);
end

bUw = [Uw; bUw(1:D)];
bUt = [Ut; bUt(1:D)];
bM  = [M;  bM(1:D)];
bIw = [Iw; bIw(1:D)];
bIt = [It; bIt(1:D)];

bOm = [omega_prev; bOm(1:D-1)];

x = zeros(5*(D+1) + D, 1);

p = 1;

for d = 1:D+1
    x(p) = bUw(d); p = p + 1;
    x(p) = bUt(d); p = p + 1;
    x(p) = bM(d);  p = p + 1;
    x(p) = bIw(d); p = p + 1;
    x(p) = bIt(d); p = p + 1;
end

for d = 1:D
    x(p) = bOm(d); p = p + 1;
end</P>
      </eml>
    </state>
    <data SSID="4" name="Uw">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="x">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
